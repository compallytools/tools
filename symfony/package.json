{
    "name": "tools",
    "private": true,
    "type": "module",
    "license": "UNLICENSED",
    "scripts": {
        "dev": "vite",
        "build": "vite build",
        "watch": "vite build --watch --mode development",
        "lint": "eslint .",
        "lint:fix": "eslint . --fix",
        "lint:style": "stylelint \"src/**/*.{scss,vue}\"",
        "lint:style:fix": "stylelint \"src/**/*.{scss,vue}\" --fix",
        "format": "prettier --write \"src/**/Resources/assets/**/*.{ts,vue,scss}\" \"assets/**/*.{ts,json}\" \"*.{ts,js,json}\"",
        "format:check": "prettier --check \"src/**/Resources/assets/**/*.{ts,vue,scss}\" \"assets/**/*.{ts,json}\" \"*.{ts,js,json}\"",
        "typecheck": "vue-tsc --noEmit"
    },
    "dependencies": {
        "@hotwired/stimulus": "^3.2.2",
        "@symfony/ux-router": "file:vendor/symfony/ux-router/assets",
        "@symfony/ux-vue": "file:vendor/symfony/ux-vue/assets",
        "vue": "^3.5.44"
    },
    "devDependencies": {
        "@eslint/js": "^10.0.1",
        "@symfony/reprise": "^1.3.0",
        "@types/node": "^26.6.6",
        "@vitejs/plugin-vue": "^6.0.10",
        "eslint": "^10.14.0",
        "eslint-config-prettier": "^10.1.8",
        "eslint-plugin-vue": "^10.12.0",
        "globals": "^17.14.0",
        "postcss-html": "^2.0.0",
        "prettier": "^3.9.10",
        "sass": "^1.107.1",
        "stylelint": "^17.16.0",
        "stylelint-config-recommended-scss": "^17.0.1",
        "stylelint-config-recommended-vue": "^2.0.0",
        "stylelint-config-standard-scss": "^17.0.0",
        "typescript": "^6.0.3",
        "typescript-eslint": "^8.72.1",
        "vite": "^8.3.5",
        "vue-eslint-parser": "^10.4.1",
        "vue-tsc": "^3.3.14"
    }
}
